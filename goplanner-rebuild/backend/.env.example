# Server
PORT=3000
NODE_ENV=development

# MongoDB (local or Atlas). DB_NAME is appended to MONGO_URI.
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=goplanner

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# AI (Hugging Face router — https://router.huggingface.co)
HF_API_KEY=your_hugging_face_token_here
HF_MODEL=moonshotai/Kimi-K2-Instruct-0905

# Weather (Open-Meteo — no API key required, left here for reference only)
# https://open-meteo.com/

# CORS — comma separated list of allowed origins for the Expo app / web build
CORS_ORIGIN=*
